{
    "files.exclude": {
        "**/*_quarentena": true
    },
    "search.exclude": {
        "**/*_quarentena": true
    },
    "python.analysis.extraPaths": [
        "${workspaceFolder}/sim/single_cycle/include",
        "${workspaceFolder}/sim/single_cycle/unit",
        "${workspaceFolder}/sim/single_cycle/integration"
    ],
    "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.vhd$|test_.*\\.py$",
        "isAsync": true,
        "cmd": "python3 scripts/gera_deps.py"
      }
    ]
  }
}