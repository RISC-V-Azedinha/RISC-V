# Força tudo para o padrão Linux (LF)
* text=auto eol=lf

# Scripts e Makefiles PRECISAM ser LF para rodar
*.sh text eol=lf
*.mk text eol=lf
makefile text eol=lf

# Arquivos binários não devem ser tocados
*.bit binary
*.bin binary
*.pdf binary

# Remove Assembly do teste de compliance
sim/core/single_cycle/e2e/sw/compliance/** linguist-vendored
sim/core/multi_cycle/e2e/sw/compliance/** linguist-vendored